<odoo>
    <!-- Internal users only: the portal group must never read traces. -->
    <record id="ai_trace_all_access" model="ir.model.access">
        <field name="name">ai_trace - all</field>
        <field name="model_id" ref="model_ai_trace" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="ai_trace_writer_access" model="ir.model.access">
        <field name="name">ai_trace - writer</field>
        <field name="model_id" ref="model_ai_trace" />
        <field name="group_id" ref="group_ai_trace_writer" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="ai_trace_system_access" model="ir.model.access">
        <field name="name">ai_trace - system</field>
        <field name="model_id" ref="model_ai_trace" />
        <field name="group_id" ref="base.group_system" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>
