<odoo>
    <record id="ai_trace_view_tree" model="ir.ui.view">
        <field name="name">ai_trace.tree</field>
        <field name="model">ai_trace</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="date" />
                <field name="model_id" />
                <field name="res_id" />
                <field name="session_key" />
                <field name="turn" />
                <field name="kind" />
                <field name="snippet" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="ai_trace_view_form" model="ir.ui.view">
        <field name="name">ai_trace.form</field>
        <field name="model">ai_trace</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header />
                <sheet>
                    <group name="group_1" colspan="4" col="2">
                        <group name="group_1_1" colspan="1" col="2">
                            <field name="model_id" />
                            <field name="res_id" />
                            <field name="session_key" />
                            <field name="turn" />
                            <field name="kind" />
                        </group>
                        <group name="group_1_2" colspan="1" col="2">
                            <field name="date" />
                            <field name="user_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page name="page_prompt" string="Prompt">
                            <field
                                name="prompt"
                                widget="ace"
                                options="{'mode': 'markdown'}"
                            />
                        </page>
                        <page name="page_action" string="Action">
                            <field
                                name="action"
                                widget="ace"
                                options="{'mode': 'json'}"
                            />
                        </page>
                        <page name="page_result" string="Result">
                            <field
                                name="result"
                                widget="ace"
                                options="{'mode': 'markdown'}"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_trace_view_search" model="ir.ui.view">
        <field name="name">ai_trace.search</field>
        <field name="model">ai_trace</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_key" />
                <field name="kind" />
                <field name="model" />
                <group name="group_by" string="Group By">
                    <filter
                        name="group_by_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}"
                    />
                    <filter
                        name="group_by_model"
                        string="Model"
                        context="{'group_by': 'model'}"
                    />
                    <filter
                        name="group_by_session_key"
                        string="Session"
                        context="{'group_by': 'session_key'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="ai_trace_action" model="ir.actions.act_window">
        <field name="name">AI Traces</field>
        <field name="res_model">ai_trace</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="ai_trace_menu"
        name="AI Traces"
        parent="root_ai_trace_menu"
        action="ai_trace_action"
        sequence="1"
    />
</odoo>
