<odoo>
    <record id="test_qr_code_view_tree" model="ir.ui.view">
        <field name="name">test.qr_code - tree</field>
        <field name="model">test.qr_code</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="test_qr_code_view_form" model="ir.ui.view">
        <field name="name">test.qr_code - form</field>
        <field name="model">test.qr_code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="test_qr_code_action" model="ir.actions.act_window">
        <field name="name">Test QR Codes</field>
        <field name="res_model">test.qr_code</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
